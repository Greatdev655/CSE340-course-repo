<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Projects</title>
    <link rel="stylesheet" href="/css/main.css" />
  </head>
  <body>
    <%- include('partials/header') %>
    <main>
      <h1 class="title"><%= title %></h1>
      <!-- <ul class="projects">
        <li>
          Park Cleanup - Join us to clean up local parks and make them
          beautiful!
        </li>
        <li>Food Drive - Help collect and distribute food to those in need.</li>
        <li>
          Community Tutoring - Volunteer to tutor students in various subjects.
        </li>
      </ul> -->

      <ul class="projects">
  <% projects.forEach(project => { %>
    <li>
      <%= new Date(project.project_date).toLocaleDateString('en-US', {
            year: 'numeric', month: 'long', day: 'numeric'
          }) %>:
      <strong><%= project.title %></strong>
      (<em><%= project.organization_name %></em>)
    </li>
  <% }); %>
</ul>
    </main>
    <%- include('partials/footer') %>
  </body>
</html>

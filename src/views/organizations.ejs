<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Organizations</title>
    <link rel="stylesheet" href="/css/main.css" />
  </head>
  <body>
    <%- include('partials/header') %>
    <main>
      <h1><%= title %></h1>
      <ul class="organization-list">
        <li>
          <img
            src="/images/brightfuture-logo.png"
            alt="BrightFuture Builders logo"
          /> <div class="organization-image-label"><strong>BrightFuture Builders</strong> <br> info@brightfuture.org</div>
        </li>
        <li>
          <img
            src="/images/greenharvest-logo.png"
            alt="GreenHarvest Growers logo"
          /><div class="organization-image-label"><strong>GreenHarvest Growers</strong><br> contact@greenharvest.org</div>
        </li>
        <li>
          <img
            src="/images/unityserve-logo.png"
            alt="UnityServe Volunteers logo"
          /> <div class="organization-image-label"><strong>UnityServe Volunteers</strong><br> hello@unityserve.org</div>
        </li>
      </ul>
    </main>
    <%- include('partials/footer') %>
  </body>
</html>
